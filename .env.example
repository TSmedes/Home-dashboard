# ---------------------------------------------------------------------------
# Secrets and deployment settings. Copy to .env and fill in.
# Everything here is optional except where a widget needs it - the dashboard
# starts fine with none of it set, and those widgets report "not set up".
#
# Run `npm run setup` to be walked through obtaining each of these.
# ---------------------------------------------------------------------------

LOG_LEVEL=info
HOST=0.0.0.0
# PORT overrides server.port in config.yaml if set.
# PORT=8080

CONFIG_PATH=./config/config.yaml
DATA_DIR=./data

# --- Google Calendar (read-only) -------------------------------------------
# Each calendar's secret iCal address. No OAuth app needed.
# Google Calendar -> Settings -> click the calendar -> Integrate calendar ->
#   "Secret address in iCal format" (not the public address)
# Several calendars: separate the addresses with commas.
#
# Treat these like passwords: anyone with one can read every event on that
# calendar. If one leaks, reset it on the same settings page.
CALENDAR_ICAL_URLS=

# --- TickTick --------------------------------------------------------------
# A personal API token. No developer app, no sign-in.
# ticktick.com/webapp -> your avatar -> Settings -> Account -> API Token
#
# Treat it like a password: it can read and change your whole TickTick account.
# If it leaks, revoke it on the same page and create another.
TICKTICK_API_TOKEN=

# --- Commute (TomTom) ------------------------------------------------------
# Drive times with live traffic. Free tier: 2,500 requests a day, no card.
# developer.tomtom.com -> sign up -> Dashboard -> Keys -> copy the default key.
# Destinations go under commute: in config.yaml.
TOMTOM_API_KEY=

# --- Spotify ---------------------------------------------------------------
# The Client ID of a Spotify developer app. It is public: sign-in uses PKCE,
# so there is no client secret to keep. After adding it, open Settings on the
# dashboard and choose Connect Spotify.
#
# developer.spotify.com/dashboard -> Create app -> Web API, redirect URI
#   http://127.0.0.1:8888/callback   (exactly this; Spotify rejects localhost)
#
# Since February 2026 Spotify only serves a developer app while its OWNER has
# Premium. On a free account the widget says "Needs Spotify Premium".
SPOTIFY_CLIENT_ID=

# --- Homelab monitoring ----------------------------------------------------
# docker-compose.yml already points these at the read-only mount of the host;
# leave them unset when running directly on the host.
# HOST_ROOT=/host
# HOST_PROC=/host/proc
# HOST_SYS=/host/sys
# DOCKER_SOCKET=/var/run/docker.sock
#
# The host's docker group id, so the container can read the Docker socket:
#   getent group docker | cut -d: -f3
DOCKER_GID=

# --- Pi-hole ---------------------------------------------------------------
# App password for the Pi-hole widget (Pi-hole > Settings > Web interface /
# API > Expert > Configure app password). Set pihole.url in config.yaml too.
PIHOLE_PASSWORD=

# --- Tapo lights -----------------------------------------------------------
# The TP-Link account (email and password) used in the Tapo app. Only lights
# with type: tapo in config.yaml need it; Kasa bulbs are controlled without one.
TAPO_USERNAME=
TAPO_PASSWORD=
