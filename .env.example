# ---------------------------------------------------------------------------
# Secrets and deployment settings. Copy to .env and fill in.
# Everything here is optional except where a widget needs it - the dashboard
# starts fine with none of it set, and those widgets report "not set up".
#
# Run `npm run setup` to be walked through obtaining each of these.
# ---------------------------------------------------------------------------

LOG_LEVEL=info
HOST=0.0.0.0
# PORT overrides server.port in config.yaml if set.
# PORT=8080

CONFIG_PATH=./config/config.yaml
DATA_DIR=./data

# --- Google Calendar (read-only) -------------------------------------------
# Each calendar's secret iCal address. No OAuth app needed.
# Google Calendar -> Settings -> click the calendar -> Integrate calendar ->
#   "Secret address in iCal format" (not the public address)
# Several calendars: separate the addresses with commas.
#
# Treat these like passwords: anyone with one can read every event on that
# calendar. If one leaks, reset it on the same settings page.
CALENDAR_ICAL_URLS=

# --- TickTick --------------------------------------------------------------
# A personal API token. No developer app, no sign-in.
# ticktick.com/webapp -> your avatar -> Settings -> Account -> API Token
#
# Treat it like a password: it can read and change your whole TickTick account.
# If it leaks, revoke it on the same page and create another.
TICKTICK_API_TOKEN=

# --- Kasa lights -----------------------------------------------------------
# Only needed if your bulbs' firmware refuses local control and the cloud
# fallback is used. Leave blank to try local control only.
KASA_USERNAME=
KASA_PASSWORD=
